# Copy this file to .env.local for local development and fill in real values
# before deploying to production. Nothing in this file should ever contain a
# committed secret — .env.local is gitignored.

# --- Site ---------------------------------------------------------------
# Canonical production URL, used for metadata, Open Graph tags and sitemap.xml.
NEXT_PUBLIC_SITE_URL=https://www.h2mb.ca

# --- Contact form ---------------------------------------------------------
# Where contact form submissions are sent. The current implementation posts to
# a Next.js server action that requires one of the following:
#
# Option A — email delivery via a transactional email API (recommended):
#   CONTACT_FORM_PROVIDER=resend
#   RESEND_API_KEY=
#   CONTACT_FORM_TO_EMAIL=       # approved H2MB inbox for form submissions
#   CONTACT_FORM_FROM_EMAIL=     # verified sending address for that provider
#
# Option B — forward to a third-party form endpoint (e.g. Formspree/Basin):
#   CONTACT_FORM_PROVIDER=webhook
#   CONTACT_FORM_ENDPOINT_URL=
#
# Until real values are supplied, the form runs in a documented "dry run"
# mode: submissions are validated end to end but not delivered anywhere, and
# the server logs a warning. See lib/contact-form.ts.
CONTACT_FORM_PROVIDER=
RESEND_API_KEY=
CONTACT_FORM_TO_EMAIL=
CONTACT_FORM_FROM_EMAIL=
CONTACT_FORM_ENDPOINT_URL=

# --- Public contact details -----------------------------------------------
# Public contact details shown in the footer and Contact page. Leave unset
# until H2MB approves real values — the site falls back to a visibly
# bracketed placeholder rather than a fabricated email/phone/link (see brief
# Section 4/11). Do NOT publish the proposed facility address (Section 11).
# NEXT_PUBLIC_CONTACT_EMAIL=info@h2mb.ca
NEXT_PUBLIC_CONTACT_PHONE=
# NEXT_PUBLIC_LINKEDIN_URL=https://www.linkedin.com/company/<approved-handle>

# --- Analytics --------------------------------------------------------
# GA4 measurement ID (or leave blank to disable analytics loading entirely).
NEXT_PUBLIC_ANALYTICS_ID=
